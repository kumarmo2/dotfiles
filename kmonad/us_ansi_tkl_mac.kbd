#| --------------------------------------------------------------------------

                     KMonad: macOS US ansi ten-key-less

  This is the macOS equivalent of `kmonad/us_ansi_tkl.kbd`.
  Behavior is kept identical to the Linux file; only `defcfg` is adapted
  for macOS input/output.

  IMPORTANT:
  - Replace the `iokit-name` placeholder below with a substring of your real
    keyboard product name.
  - `iokit-name` is NOT a shell command. It is a KMonad config option.
  - `output (kext)` on macOS commonly relies on the Karabiner VirtualHID
    driver being installed.

(deflayer name
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _                    _
  _    _    _              _              _    _    _    _               _    _    _
)

  -------------------------------------------------------------------------- |#
(defcfg
  ;; KMonad input source on macOS.
  ;; `iokit-name` matches a substring of the physical keyboard's product name.
  ;; Here it matches the built-in Mac keyboard.
  input  (iokit-name "Apple Internal Keyboard / Trackpad")

  ;; KMonad output sink on macOS.
  ;; `kext` sends remapped events through the macOS virtual keyboard driver.
  output (kext)

  ;; Compose key configuration. `cmp` in `defsrc` acts as Right Alt compose.
  cmp-seq ralt
  ;; Small delay between compose key sequence events.
  cmp-seq-delay 5

  ;; If a key is not remapped in the active layer, let it pass through normally.
  fallthrough true

  ;; Allow KMonad commands/macros that execute commands.
  allow-cmd true

  ;; Use `around` as the default wrapper behavior for implicit modifier handling.
  implicit-around around
)

( defalias 
  ;; Toggle helper for layer `one`.
  ;; Not used directly right now, but handy to keep around while learning.
  layerone (layer-toggle one)

  ;; `around` presses the modifier and, at the same time, activates a layer.
  ;; While left/right Command is held, also enter `cmdnav`.
  lcmdnav (around lmet (momentary-layer cmdnav))
  rcmdnav (around rmet (momentary-layer cmdnav))

  ;; Home-row mods.
  ;; Pattern: (tap-hold-next-release TIME tap-key hold-action)
  ;; - quick tap => sends the letter/key
  ;; - hold => becomes modifier/layer action
  ;; - 180 is the tap/hold timing threshold in ms
  lcl (tap-hold-next-release 180 a lctl)
  lmt (tap-hold-next-release 180 s @lcmdnav)
  lat (tap-hold-next-release 180 d lalt)
  lst (tap-hold-next-release 180 f lsft)

  ;; Quote, Escape, and Space become layer keys when held.
  ;; - tap `'` => '
  ;; - hold `'` => layer `one`
  ;; - tap `esc` => escape
  ;; - hold `esc` => layer `one`
  ;; - tap `space` => space
  ;; - hold `space` => layer `one`
  qul1 (tap-hold-next-release 180 ' @layerone)
  escl1 (tap-hold-next-release 180 esc @layerone)
  spacel1 (tap-hold-next-release 180 spc @layerone)

  ;; Right-hand home-row mods.
  ;; Note: `;` is mapped to left control here, matching the Linux config.
  rcl (tap-hold-next-release 180 ; lctl)
  rmt (tap-hold-next-release 180 l @rcmdnav)
  rat (tap-hold-next-release 180 k lalt)
  rst (tap-hold-next-release 180 j lsft)
)
;; (defalias layerone (layer-toggle one))


;; `defsrc` describes the physical keyboard layout KMonad listens to.
;; Every `deflayer` below must match this exact key order/shape.
;; Think of this as the coordinate system for all layers.
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc  ins  home pgup
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \     del  end  pgdn
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft                 up       
  lctl lmet lalt           spc            ralt rmet cmp  rctl            left down rght
)

;; Base layer = your normal typing layer.
;; `_` means "transparent": fall back to the key from `defsrc`.
;; `@name` means "use alias `name` from defalias".
;;
;; Top row note for macOS:
;; KMonad intercepts Apple function keys before macOS can translate them into
;; brightness / media / volume actions. So we emit those Apple actions here
;; directly, following KMonad's `apple.kbd` template.
;; F1  = brightness down      F7  = previous track
;; F2  = brightness up        F8  = play/pause
;; F3  = Launchpad            F9  = next track
;; F4  = Mission Control      F10 = mute
;; F5  = keyboard backlight down (may be a no-op on some newer Macs)
;; F6  = keyboard backlight up   (may be a no-op on some newer Macs)
;; F11 = volume down
;; F12 = volume up
(deflayer base
  caps   brdn brup       lp   mctl bldn blup prev pp   next      mute vold volu
  _      _    _          _    _    _    _    _    _         _    _    _     _    _     _    _    _
  _      _    _          _    _    _    _    _    _         _    _    _     _    _     _    _    _
  @escl1 @lcl @lmt       @lat @lst _    _    @rst @rat      @rmt @rcl @qul1 _
  _    _    _          _    _    _    _    _    _         _    _    _                    _
  _    @lcmdnav _                    @spacel1       _         @rcmdnav _    _               _    _    _
)

;; Active only while a Command trigger is held. We only override J/K so
;; normal Command shortcuts keep working through the transparent keys.
;; Important: J/K send plain Shift+Tab / Tab here because Command is already
;; being held by @lcmdnav/@rcmdnav. That keeps the macOS app switcher open
;; until the Command trigger is released.
(deflayer cmdnav
  _    _    _    _    _    _    _    _      _    _    _    _    _
  _    _    _    _    _    _    _    _      _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    _      _    _    _    _    _    _     _    _    _
  _    _    _    _    _    _    _    S-tab  tab  _    _    _    _
  _    _    _    _    _    _    _    _      _    _    _    _                    _
  _    _    _              _              _    _    _    _               _    _    _
)

;; Layer `one` = navigation + symbols/numbers helper layer.
;; Current functions:
;; - hold Space / Escape / Quote to enter this layer
;; - W E R T Y U I O P [ map to 1 2 3 4 5 6 7 8 9 0
;; - H J K L become arrow keys
;; - ] and [ on this layer switch macOS desktops via Ctrl+Right / Ctrl+Left
;; - Return becomes Backspace
(deflayer one
  _    _    _    _    _    _    _    _    _    _      _       _        _
  _    _    _    _    _    _    _    _    _    _      _       _        _    _     _    _    _
  _    1    2    3    4    5    6    7    8    9      0       C-left   C-right _    _    _    _
  _    _    _    _    _    _    left down up   right  _       _        bspc
  _    _    _    _    _    _    _    _    _    _      _       _                    _
  _    _    _              _              _    _      _       _               _    _    _
)
